registry=https://registry.npmjs.org

# NOTE: the supply-chain soak (`minimumReleaseAge`) deliberately does NOT live here.
# pnpm only auto-enables strict enforcement when the setting comes from
# `pnpm-workspace.yaml`, `config.yaml`, the CLI or the environment. A `minimumreleaseage`
# key in this file runs in LOOSE mode while looking configured — on a too-young package
# pnpm then silently appends it to `minimumReleaseAgeExclude` and installs anyway. npm
# also warns that it is not a valid npmrc key. See pnpm-workspace.yaml.

auto-install-peer=true
strict-peer-dependencies=false
