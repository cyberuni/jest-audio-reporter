registry=https://registry.npmjs.org

# Only genuine npm config belongs in this file. pnpm's own settings live in
# pnpm-workspace.yaml — npm warns on them here ("Unknown project config ..."), and for
# `minimumReleaseAge` the placement is not cosmetic but load-bearing: pnpm auto-enables
# strict enforcement only when that setting comes from pnpm-workspace.yaml, config.yaml,
# the CLI or the environment. Set in this file it runs in LOOSE mode while looking
# configured, silently appending too-young packages to `minimumReleaseAgeExclude` and
# installing them anyway.
